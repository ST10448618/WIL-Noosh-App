@{
    ViewData["Title"] = "Page Not Found";
}
<section class="auth-section" style="min-height: 70vh;">
    <div class="container text-center">
        <p class="section-eyebrow">Error 404</p>
        <h1 class="hero-title" style="font-size: 5rem;">Lost?</h1>
        <p class="auth-subtitle" style="max-width: 400px; margin: 1rem auto 2rem;">
            The page you're looking for doesn't exist — but the shawarmas definitely do.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-hero-primary">
            <i class="fa-solid fa-house me-2"></i>Back to Home
        </a>
    </div>
</section>