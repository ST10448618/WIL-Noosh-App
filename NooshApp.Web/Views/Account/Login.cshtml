@{
    ViewData["Title"] = "Login";
}

<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-auth-compat.js"></script>

<section class="auth-section">
    <div class="container">
        <div class="auth-card">
            <p class="section-eyebrow text-center">Noosh Rewards</p>

            <div class="tabs mb-3" id="authTabs">
                <button type="button" class="tab-btn active" data-tab="login">Log In</button>
                <button type="button" class="tab-btn" data-tab="register">Create Account</button>
            </div>

            <!-- LOG IN -->
            <div id="loginTab">
                <h1 class="auth-title">Welcome Back</h1>
                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <input type="email" id="loginEmail" class="form-control auth-input" placeholder="you@example.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" id="loginPassword" class="form-control auth-input" />
                </div>
                <button type="button" id="loginBtn" class="btn btn-hero-primary w-100">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Log In
                </button>
            </div>

            <!-- REGISTER -->
            <div id="registerTab" class="d-none">
                <h1 class="auth-title">Join Noosh Rewards</h1>
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" id="registerName" class="form-control auth-input" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email Address</label>
                    <input type="email" id="registerEmail" class="form-control auth-input" placeholder="you@example.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" id="registerPassword" class="form-control auth-input" placeholder="At least 6 characters" />
                </div>
                <button type="button" id="registerBtn" class="btn btn-hero-primary w-100">
                    <i class="fa-solid fa-user-plus me-2"></i>Create Account
                </button>
            </div>

            <div id="loginError" class="text-danger mt-3"></div>
        </div>
    </div>
</section>

@section Scripts {
<script>
    const firebaseConfig = {
        apiKey: "@ViewBag.FirebaseApiKey",
        authDomain: "@ViewBag.FirebaseAuthDomain",
        projectId: "@ViewBag.FirebaseProjectId"
    };
    firebase.initializeApp(firebaseConfig);

    const errorBox = document.getElementById('loginError');
