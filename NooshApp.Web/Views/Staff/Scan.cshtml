@{
    ViewData["Title"] = "Staff Scanner";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Scanner</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <style>
        body { background: var(--color-ink); }
        .scan-wrap { max-width: 480px; margin: 2rem auto; padding: 0 1rem; }
        #reader { border: 3px solid var(--color-primary); border-radius: var(--radius-md); overflow: hidden; }
        .staff-topbar { display: flex; justify-content: space-between; align-items: center; color: var(--color-white); margin-bottom: 1rem; }
        .staff-topbar a { color: var(--color-primary); text-decoration: none; font-weight: 600; font-size: 0.85rem; }
        .amount-input-wrap { margin-top: 1rem; }
        .amount-input-wrap input { font-size: 1.3rem; text-align: center; font-weight: 700; }
    </style>
</head>
<body>
    <div class="scan-wrap">
        <div class="staff-topbar">
            <strong>Noosh Staff</strong>
            <a asp-controller="Staff" asp-action="Redeem" class="internal-link">Redeem Reward</a>
        </div>

        <div class="auth-card">
            <p class="section-eyebrow text-center">Enter Sale Amount First</p>
            <div class="amount-input-wrap">
                <input type="number" id="amountPaid" class="form-control auth-input" placeholder="R 0.00" step="0.01" />
            </div>
        </div>

        <div id="reader" class="mt-3"></div>
        
        <div id="statusBox" class="mt-3"></div>

        <a asp-controller="Staff" asp-action="Logout" class="d-block text-center mt-3" style="color:#888;font-size:0.8rem;">Log out</a>
    </div>
@Html.AntiForgeryToken()
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const statusBox = document.getElementById('statusBox');
        let isProcessing = false;

        function showStatus(result) {
            const cls = result.success ? 'staff-status success' : 'staff-status error';
            statusBox.innerHTML = `<div class="${cls}">
                ${result.message}
                ${result.success ? `<span class="balance-line">New balance: ${result.balance} pts</span>` : ''}
            </div>`;
        }

        async function submitScan(qrToken) {
            const amountPaid = parseFloat(document.getElementById('amountPaid').value);
            if (!amountPaid || amountPaid <= 0) {
                statusBox.innerHTML = '<div class="status error" style="padding:1rem;background:#F4CCCC;color:#a30000;border-radius:8px;text-align:center;font-weight:bold;">Enter the sale amount first.</div>';
                return;
            }
            if (isProcessing) return;
            isProcessing = true;

            const res = await fetch('/Staff/SubmitScan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: `token=${encodeURIComponent(qrToken)}&amountPaid=${amountPaid}`
            });
            const data = await res.json();
            showStatus(data);

            document.getElementById('amountPaid').value = '';
            setTimeout(() => { isProcessing = false; }, 2000);
        }

        const scanner = new Html5Qrcode("reader");
        scanner.start(
            { facingMode: "environment" },
            { fps: 10, qrbox: 250 },
            (decodedText) => submitScan(decodedText),
            () => {}
        ).catch(err => {
            statusBox.innerHTML = `<div style="color:white;text-align:center;">Camera unavailable — use manual entry below.</div>`;
        });

        document.getElementById('manualScanBtn').addEventListener('click', () => {
            const val = document.getElementById('manualToken').value.trim();
            if (val) submitScan(val);
        });
    </script>
</body>
</html>